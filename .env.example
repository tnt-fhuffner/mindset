# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App (use the Vercel URL in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_MASTER_ADMIN_EMAIL=felipeqh.1991@gmail.com

# Set to true only after enabling Google in Supabase → Authentication → Providers
NEXT_PUBLIC_GOOGLE_AUTH=false

# AI assistant (optional until you enable generation)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
AI_MONTHLY_LIMIT=15

# Optional: max upload size in bytes (default 10 MB)
UPLOAD_MAX_BYTES=10485760
